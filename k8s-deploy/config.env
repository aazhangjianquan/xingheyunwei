# API and Worker share these non-secret values.
INSTANCE_DIR=/app/instance
SQL_DIR=/app/database
DATABASE_CONFIG_MODE=environment
REQUIRE_SHARED_KEYS=true
SEED_DEMO_DATA=false
REDIS_URL=redis://workspace-redis:6379/0
REDIS_NAMESPACE=project_workspace_prod
ATTACHMENT_STORAGE=minio
MINIO_ENDPOINT=http://115.190.46.231:9000
MINIO_BUCKET=yunweishenji
MINIO_REGION=us-east-1
LICENSE_TOOL_JAR=/app/license-tool/LicenseTool-1.0-SNAPSHOT-jar-with-dependencies.jar
JAVA_BIN=java
HOME=/tmp
TMPDIR=/tmp
XDG_CACHE_HOME=/tmp/.cache
# Audit source IP only: request rate limiting and frequency alerts are disabled.
# MUST match your cluster's frontend Pod addresses. NetworkPolicy restricts callers.
TRUSTED_PROXY_CIDRS=10.244.0.0/16
CORS_ORIGINS=https://workspace.example.com
# Frontend only: these values are substituted into frontend-nginx.conf.
API_UPSTREAM=workspace-api:8000
DNS_RESOLVER=kube-dns.kube-system.svc.cluster.local
# MUST match the real socket sources used by your Ingress Controller.
INGRESS_PROXY_CIDR=10.244.0.0/16
